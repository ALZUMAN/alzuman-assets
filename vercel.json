{
  "rewrites": [
    { "source": "/assets/:path*", "destination": "https://raw.githubusercontent.com/ALZUMAN/alzuman-assets/claude/alzuman-vercel-deploy-itkb8l/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.mp4",
      "headers": [
        { "key": "Content-Type", "value": "video/mp4" },
        { "key": "Accept-Ranges", "value": "bytes" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)\\.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
